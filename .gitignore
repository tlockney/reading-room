# Build artifacts — regenerated by `deno task build` (into example/, the dev
# content home); the live server (`deno task serve`) renders dynamically and
# never reads these.
/example/docs/
/example/index.html
/example/manifest.webmanifest
/example/sw.js
/example/favicon.svg
/example/apple-touch-icon.png
/example/icon-192.png
/example/icon-512.png

# LaunchAgent logs (agent.sh)
.agent.out.log
.agent.err.log

# Scratch space for importing docs (raw html, defuddled md, assembled editorial)
/_work/

# Remote-publish staging (deno task publish)
/.publish/
/example/.publish/
